---
import { image } from '../lib/data';
import type { Lang } from '../i18n/strings';

interface Props {
  slot: string;
  lang: Lang;
  sizes?: string;
  eager?: boolean;
  class?: string;
  /** Extra attributes for the inner <img> (e.g. data-speed for parallax). */
  imgClass?: string;
  pendingLabel?: string;
}
const { slot, lang, sizes = '100vw', eager = false, class: cls = '', imgClass = '', pendingLabel = '' } = Astro.props;
const img = image(slot, lang);
const style = `--tone:${img.tone};${img.blur ? `--blur:url(${img.blur});` : ''}`;
---
<div class:list={['pic', cls, { 'pic--pending': img.pending, 'pic--blur': !!img.blur }]} style={style} data-slot={slot}>
  {img.pending ? (
    <div class="pic__todo" role="img" aria-label={img.alt}>
      <svg viewBox="0 0 120 120" aria-hidden="true"><use href="#motif-star" /></svg>
      <span>{pendingLabel}</span>
    </div>
  ) : (
    <picture>
      {img.avif && <source type="image/avif" srcset={img.avif} sizes={sizes} />}
      {img.webp && <source type="image/webp" srcset={img.webp} sizes={sizes} />}
      <img
        class={imgClass}
        src={img.src}
        srcset={img.srcset ?? undefined}
        sizes={sizes}
        alt={img.alt}
        width={img.width}
        height={img.height}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        decoding="async"
        data-fade
      />
    </picture>
  )}
</div>
